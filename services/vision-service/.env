# For local testing
SEG_CONF=0.3
SEG_IOU=0.5
SEG_END2END=False
SEG_RECT=False
# PaddleOCR parameters
PADDLEOCR_TEXT_DETECTION_MODEL_NAME="PP-OCRv6_medium_det"
PADDLEOCR_TEXT_RECOGNITION_MODEL_NAME="PP-OCRv6_medium_rec"
## Preprocessing parameters
## For main pipeline
PADDLEOCR_USE_DOC_ORIENTATION_CLASSIFY=True
PADDLEOCR_USE_DOC_UNWARPING=True
PADDLEOCR_USE_TEXTLINE_ORIENTATION=True
## For data prep purpose
PADDLEPREPRO_DOC_UNWARPING_MODEL_NAME="UVDoc"
PADDLEPREPRO_DOC_ORIENTATION_CLASSIFY_MODEL_NAME="PP-LCNet_x1_0_doc_ori"
PADDLEPREPRO_USE_DOC_ORIENTATION_CLASSIFY=True
PADDLEPREPRO_USE_DOC_UNWARPING=True
## Text detection parameters
PADDLEOCR_TEXT_DET_THRESH=0.3
PADDLEOCR_TEXT_DET_BOX_THRESH=0.5
PADDLEOCR_TEXT_DET_UNCLIP_RATIO=1.5
## Text recognition parameters
PADDLEOCR_TEXT_REC_SCORE_THRESH=0.6
PADDLEOCR_LANG="fr"
PADDLEOCR_DEVICE="cpu"
## LOG DEV
VISION_LOG_JSON=False