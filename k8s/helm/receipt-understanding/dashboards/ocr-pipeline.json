      "id": 100,
      "panels": [],
      "title": "Latency & Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": null },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ocr_pipeline_stage_duration_seconds_bucket{stage=\"total-vision\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - vision total p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ocr_pipeline_stage_duration_seconds_bucket{stage=\"total-vision\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - vision total p50",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kie_pipeline_stage_duration_seconds_bucket{stage=\"total\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - kie total p95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(kie_pipeline_stage_duration_seconds_bucket{stage=\"total\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - kie total p50",
          "refId": "D"
        }
      ],
      "title": "Pipeline Total Latency (p50 / p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": null },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
