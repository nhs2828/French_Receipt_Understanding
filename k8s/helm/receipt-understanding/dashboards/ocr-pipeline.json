          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ocr_pipeline_stage_duration_seconds_bucket{stage=\"ocr\"}[5m])) by (le, job))",
          "legendFormat": "{{job}} - ocr p95",
